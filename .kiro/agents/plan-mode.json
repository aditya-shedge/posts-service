{
  "name": "plan-mode",
  "description": "Plan Mode to create the detailed technical implementation plans for software development requirements.",
  "prompt": "file://./prompts/plan-mode.agent.md",
  "mcpServers": {},
  "tools": ["read", "write", "code", "grep", "glob", "shell"],
  "toolAliases": {},
  "allowedTools": ["read", "write", "code", "grep", "glob", "shell"],
  "toolsSettings": {
    "shell": {
      "allowedCommands": ["git status", "git fetch"],
      "deniedCommands": ["git commit .*", "git push .*"],
      "autoAllowReadonly": true
    },
    "@git/git_status": {
      "git_user": "$GIT_USER"
    }
  },
  "resources": [
    "file://../artifacts/**/*.md",
    "file://./guidelines/**/*.md"
  ],
  "hooks": {},
  "useLegacyMcpJson": true,
  "model": "claude-opus-4.5"
}
